FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/sellbuydeal run build

FROM nginx:1.27-alpine
COPY deploy/caprover/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/caprover/40-bazunk-config.sh /docker-entrypoint.d/40-bazunk-config.sh
RUN chmod +x /docker-entrypoint.d/40-bazunk-config.sh
COPY --from=build /app/artifacts/sellbuydeal/dist /usr/share/nginx/html
EXPOSE 80
